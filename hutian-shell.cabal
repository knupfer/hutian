cabal-version:      3.4
name:               hutian-shell
version:            0.6.0.0
synopsis:           Interactive shell for the hutian sandbox
description:        A small interactive shell with a streaming llama.cpp
                    prompt and a two-mode multiline editor.
author:             Florian Knupfer
license:            MIT
license-file:       LICENSE
build-type:         Simple
extra-source-files:
    CHANGELOG.md
    README.md

common defaults
  default-language: GHC2021
  default-extensions: DerivingStrategies
  ghc-options:
      -Wall
      -Werror
      -Wcompat
      -Wincomplete-record-selectors
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-deriving-strategies
      -Wmissing-export-lists
      -Woperator-whitespace
      -Wpartial-fields
      -Wredundant-bang-patterns
      -Wredundant-constraints
      -Wredundant-record-wildcards
      -Wredundant-strictness-flags
      -Wunused-packages
      -threaded

common dependencies
  build-depends:
      aeson
    , ansi-terminal
    , base >=4.14 && <5
    , bytestring
    , colour
    , containers
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , process
    , skylighting
    , text
    , unix
    , vector

library
  import:           defaults, dependencies
  hs-source-dirs:   app
  exposed-modules:
      Hutian.Ansi
      Hutian.Cli
      Hutian.Command
      Hutian.Completion
      Hutian.Console
      Hutian.Conversation
      Hutian.Editor
      Hutian.Highlight
      Hutian.History
      Hutian.History.Store
      Hutian.Http.Wire
      Hutian.Interrupt
      Hutian.Jobs
      Hutian.Jobs.Runtime
      Hutian.Key
      Hutian.Llm
      Hutian.Llm.Loop
      Hutian.Llm.Presentation
      Hutian.Llm.Request
      Hutian.Llm.Settings
      Hutian.Llm.Stream
      Hutian.Llm.UnixSocket
      Hutian.Markdown
      Hutian.Paths
      Hutian.Policy
      Hutian.Prompt
      Hutian.Relay
      Hutian.Relay.Protocol
      Hutian.Render
      Hutian.Session
      Hutian.Shell
      Hutian.Terminal
      Hutian.Tool
      Hutian.Tool.Exec
  build-depends:
      network
    , terminal-size

executable hutian-shell
  import:           defaults
  main-is:          Main.hs
  hs-source-dirs:   exe
  build-depends:
      base
    , directory
    , hutian-shell

executable hutian-llm-relay
  import:           defaults
  main-is:          RelayMain.hs
  hs-source-dirs:   exe
  build-depends:
      base
    , http-client
    , hutian-shell
    , unix

test-suite hutian-shell-test
  import:           defaults
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  other-modules:
      CliSpec
      CommandSpec
      CompletionSpec
      ConsoleSpec
      ConversationSpec
      EditorSpec
      HighlightSpec
      HistorySpec
      InterruptSpec
      JobsSpec
      LlmIntegrationSpec
      LlmLoopSpec
      LlmPresentationSpec
      LlmSocketSpec
      LlmSpec
      LlmStreamSpec
      MarkdownSpec
      PathsSpec
      PolicySpec
      PromptSpec
      RelaySpec
      RenderSpec
      SessionSpec
      ShellSpec
      TestReporter
      TestSupport
      ToolSpec
      WireSpec
  hs-source-dirs:   test
  build-depends:
      aeson
    , ansi-terminal
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , hutian-shell
    , network
    , QuickCheck
    , stm
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , unix
    , vector
