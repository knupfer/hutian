cabal-version:      2.4
name:               hutian-shell
version:            0.2.0.0
synopsis:           Interactive shell for the hutian sandbox
description:        A small interactive shell with a streaming llama.cpp
                    prompt and a two-mode multiline editor.
author:             Florian Knupfer
license:            MIT
build-type:         Simple

common defaults
  default-language: Haskell2010
  default-extensions: DerivingStrategies
  ghc-options:
      -Wall
      -Werror
      -Wcompat
      -Wincomplete-record-selectors
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-deriving-strategies
      -Wmissing-export-lists
      -Woperator-whitespace
      -Wpartial-fields
      -Wredundant-bang-patterns
      -Wredundant-constraints
      -Wredundant-record-wildcards
      -Wredundant-strictness-flags
      -Wunused-packages

common dependencies
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , filepath
    , http-client
    , http-types
    , process
    , skylighting
    , text
    , unix
    , vector

executable hutian-shell
  import:           defaults, dependencies
  main-is:          Main.hs
  other-modules:
      Hutian.Conversation
      Hutian.Editor
      Hutian.History
      Hutian.Interrupt
      Hutian.Llm
      Hutian.Markdown
      Hutian.Paths
      Hutian.Shell
      Hutian.Terminal
  hs-source-dirs:   app
  build-depends:
      terminal-size

test-suite hutian-shell-test
  import:           defaults, dependencies
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  other-modules:
      ConversationSpec
      EditorSpec
      HistorySpec
      Hutian.Conversation
      Hutian.Editor
      Hutian.History
      Hutian.Interrupt
      Hutian.Llm
      Hutian.Markdown
      Hutian.Paths
      Hutian.Shell
      InterruptSpec
      LlmIntegrationSpec
      LlmSpec
      MarkdownSpec
      PathsSpec
      ShellSpec
  hs-source-dirs:   test app
  build-depends:
      network
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck