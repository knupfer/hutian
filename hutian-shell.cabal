cabal-version:      3.4
name:               hutian-shell
version:            0.4.0.0
synopsis:           Interactive shell for the hutian sandbox
description:        A small interactive shell with a streaming llama.cpp
                    prompt and a two-mode multiline editor.
author:             Florian Knupfer
license:            MIT
license-file:       LICENSE
build-type:         Simple
extra-source-files:
    CHANGELOG.md
    README.md

common defaults
  default-language: GHC2021
  default-extensions: DerivingStrategies
  ghc-options:
      -Wall
      -Werror
      -Wcompat
      -Wincomplete-record-selectors
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-deriving-strategies
      -Wmissing-export-lists
      -Woperator-whitespace
      -Wpartial-fields
      -Wredundant-bang-patterns
      -Wredundant-constraints
      -Wredundant-record-wildcards
      -Wredundant-strictness-flags
      -Wunused-packages

common dependencies
  build-depends:
      aeson
    , ansi-terminal
    , base >=4.14 && <5
    , bytestring
    , colour
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , process
    , skylighting
    , text
    , unix
    , vector

executable hutian-shell
  import:           defaults, dependencies
  main-is:          Main.hs
  other-modules:
      Hutian.Ansi
      Hutian.Command
      Hutian.Completion
      Hutian.Console
      Hutian.Conversation
      Hutian.Editor
      Hutian.History
      Hutian.History.Store
      Hutian.Http.Wire
      Hutian.Interrupt
      Hutian.Key
      Hutian.Llm
      Hutian.Llm.Protocol
      Hutian.Llm.UnixSocket
      Hutian.Markdown
      Hutian.Output
      Hutian.Paths
      Hutian.Policy
      Hutian.Prompt
      Hutian.Relay.Protocol
      Hutian.Render
      Hutian.Shell
      Hutian.Terminal
  hs-source-dirs:   app
  build-depends:
      network
    , terminal-size

executable hutian-llm-relay
  import:           defaults
  main-is:          RelayMain.hs
  other-modules:
      Hutian.Http.Wire
      Hutian.Relay
      Hutian.Relay.Protocol
  hs-source-dirs:   app
  build-depends:
      base
    , bytestring
    , directory
    , http-client
    , http-client-tls
    , http-types
    , network
    , text
    , unix

test-suite hutian-shell-test
  import:           defaults, dependencies
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  other-modules:
      CommandSpec
      CompletionSpec
      ConsoleSpec
      ConversationSpec
      EditorSpec
      HistorySpec
      Hutian.Ansi
      Hutian.Command
      Hutian.Completion
      Hutian.Console
      Hutian.Conversation
      Hutian.Editor
      Hutian.History
      Hutian.History.Store
      Hutian.Http.Wire
      Hutian.Interrupt
      Hutian.Key
      Hutian.Llm
      Hutian.Llm.Protocol
      Hutian.Llm.UnixSocket
      Hutian.Markdown
      Hutian.Output
      Hutian.Paths
      Hutian.Policy
      Hutian.Prompt
      Hutian.Relay
      Hutian.Relay.Protocol
      Hutian.Render
      Hutian.Shell
      InterruptSpec
      LlmIntegrationSpec
      LlmProtocolSpec
      LlmSocketSpec
      LlmSpec
      MarkdownSpec
      PathsSpec
      PolicySpec
      PromptSpec
      RelaySpec
      RenderSpec
      ShellSpec
      TestSupport
  hs-source-dirs:   test app
  build-depends:
      network
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , terminal-size
